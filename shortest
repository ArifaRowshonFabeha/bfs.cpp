#include <bits/stdc++.h>
using namespace std;
void bfs_shortestPath(int source, int destination, vector<vector<int>>& graph, vector<int>& dist,
                      vector<int>& parent) {
    queue<int> q;
    q.push(source);
    dist[source] = 0;
    parent[source] = -1;

    while (!q.empty()) {
        int u = q.front();
        q.pop();

        for (int i : graph[u]) {
            if (dist[i] == INT_MAX) {
                dist[i] = dist[u] + 1;
                parent[i] = u;
                q.push(i);

                if (i == destination)
                    return;
            }
        }
    }
}
